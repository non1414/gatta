# انسخي هذا الملف إلى .env.test.local واملئي القيم من مشروع Supabase
# التجريبي المنفصل (لا الإنتاج). .env.test.local مستثنى من Git تلقائيًا
# (النمط .env* في .gitignore).
#
# لا تضعي هنا مفاتيح مشروع الإنتاج تحت أي ظرف — سكربت
# scripts/run-app-against-test-env.sh يرفض التشغيل إن تطابق الرابط هنا مع
# رابط .env.local (الإنتاج) كحماية إضافية، لكنه ليس بديلًا عن الحذر اليدوي.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-TEST-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-test-project-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-test-project-service-role-key
